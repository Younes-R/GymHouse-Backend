// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum UserType {
  ADMIN
  CLIENT
}

enum PlanType {
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUND_REQUIRED
  REFUNDED
}

enum PaymentMethod {
  CASH
  ONLINE
}

model User {
  userId        Int            @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String         @unique()
  phoneNumber   Int
  password      String
  birthDate     DateTime
  gender        Gender
  userType      UserType
  subscriptions Subscription[]
}

model Plan {
  planId        Int            @id @default(autoincrement())
  planType      PlanType
  price         Float
  subscriptions Subscription[]
}

model Subscription {
  subscriptionId  Int                      @id @default(autoincrement())
  userId          Int
  user            User                     @relation(fields: [userId], references: [userId])
  planId          Int
  plan            Plan                     @relation(fields: [planId], references: [planId])
  priceAtPurchase Float
  subscrptionTime Unsupported("tstzrange")
  createdAt       DateTime                 @default(now())
  payments        Payment[]
}

model Payment {
  paymentId      Int           @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription  @relation(fields: [subscriptionId], references: [subscriptionId])
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  PaymentMethod
  transactionId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Session {
  sessionId   Int                      @id @default(autoincrement())
  sessionTime Unsupported("tstzrange")
  gender      Gender
}
